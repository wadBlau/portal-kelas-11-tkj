# Salin ke .env.local untuk development.
# Di Vercel, cukup isi NEXTAUTH_SECRET lewat dashboard (NEXTAUTH_URL otomatis).
#
# Generate secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NEXTAUTH_SECRET=ganti-dengan-string-acak

# Hanya untuk lokal. Jangan dipakai di Vercel.
NEXTAUTH_URL=http://localhost:3000
